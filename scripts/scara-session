#!/bin/sh
# MARCH SCARA Official Session Startup

export XDG_CURRENT_DESKTOP=MARCH-SCARA
export XDG_SESSION_DESKTOP=MARCH-SCARA
export XDG_SESSION_TYPE=wayland
export SCARA_BACKEND=drm
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11"
export GSK_RENDERER=gl

# Nyalakan audio PipeWire
systemctl --user start pipewire pipewire-pulse wireplumber 2>/dev/null

# Jalankan MARCH SCARA Compositor
exec /usr/bin/scara-wm "$@"
